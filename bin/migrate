#!/usr/bin/env bash
# Copy files that nothing else covers (app data, game saves, history) from
# the old Mac over SSH. See `nx migrate --help`.

set -euo pipefail

# shellcheck disable=SC1091
source "${BASH_SOURCE[0]%/*}/shared"
export USE_ICON_STYLE=true

BASELINE_DIR="${BASELINE_DIR:-$HOME/.local/share/nix-managed-baselines}"

# path (relative to $HOME) | process that must be closed on both Macs |
# comma-separated rsync excludes (relative to the path) | mode. Mode "merge"
# is for line-based files both Macs add to: this Mac keeps its lines and gains
# the old Mac's, instead of being replaced
MIGRATE_ENTRIES=(
    "Library/Application Support/Paradox Interactive||"
    "Library/Containers/com.pocketpair.palworld.mac|Palworld|"
    "Library/RenPy||"
    "Library/Application Support/Transmit|Transmit|Logs"
    "Library/Application Support/com.charliemonroe.Downie-4|Downie 4|"
    "Library/Containers/com.charliemonroe.Downie-4|Downie 4|"
    "Library/Application Support/com.conductor.app|conductor|agent-binaries,bin,cache.db*"
    "conductor|conductor|"
    ".claude||"
    ".claude.json||"
    ".zsh_history|||merge"
    ".ssh/known_hosts|||merge"
    ".local/share/cyberdrop-dl||"
    ".local/state/cyberdrop-dl||"
    ".config/openlogi||*.lock,armed-session,overlay.claim"
    ".local/share/openlogi||"
    ".local/state/openlogi||*.lock,*.log"
    ".config/scriptbin/cookies.txt||"
)

# Print one field (path, process, excludes or mode) of a MIGRATE_ENTRIES item
entry_field() {
    local entry="$1" field="$2" path process excludes mode
    IFS='|' read -r path process excludes mode <<< "$entry"
    case "$field" in
        path) echo "$path" ;;
        process) echo "$process" ;;
        excludes) echo "$excludes" ;;
        mode) echo "$mode" ;;
        *) log_error "entry_field: unknown field '$field'"; return 1 ;;
    esac
}

# Print, relative to $HOME/<relpath>, every file under it that Nix manages on
# this Mac: Home Manager symlinks into /nix/store, and mutable files (each has
# a baseline under $BASELINE_DIR). These become rsync excludes
nix_managed_excludes() {
    local relpath="$1" root="$HOME/$1" f target
    {
        if [[ -d "$root" ]]; then
            while IFS= read -r -d '' f; do
                target="$(readlink "$f")"
                [[ "$target" == /nix/store/* ]] && echo "${f#"$root"/}"
            done < <(find "$root" -type l -print0 2>/dev/null)
        fi
        if [[ -d "$BASELINE_DIR/$relpath" ]]; then
            while IFS= read -r -d '' f; do
                echo "${f#"$BASELINE_DIR/$relpath"/}"
            done < <(find "$BASELINE_DIR/$relpath" -type f -print0)
        fi
    } | sort -u
}

# Print each folder path in a Syncthing config.xml, with ~ expanded
syncthing_folder_paths() {
    # A literal "~/" prefix, which Syncthing writes for home-relative folders
    # shellcheck disable=SC2088
    local config="$1" path tilde='~/'
    xmllint --xpath '//folder/@path' "$config" 2>/dev/null \
        | grep -o 'path="[^"]*"' \
        | sed -e 's/^path="//' -e 's/"$//' \
        | while IFS= read -r path; do
            [[ "$path" == "$tilde"* ]] && path="$HOME/${path#"$tilde"}"
            echo "$path"
        done
}

# Return 0 if $HOME/<relpath> is one of the given folders or inside one
inside_synced_folder() {
    local abs="$HOME/$1" folder
    shift
    for folder in "$@"; do
        folder="${folder%/}"
        [[ "$abs" == "$folder" || "$abs" == "$folder"/* ]] && return 0
    done
    return 1
}

# ============================================================================
# Talking to the old Mac
# ============================================================================

HOST=""
CONTROL_PATH="${CONTROL_PATH:-/tmp/nx-migrate-$$}"
REMOTE_RSYNC=/run/current-system/sw/bin/rsync

# ServerAlive bounds a dead connection, since nothing else here times out
SSH_BOUNDS=(-o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=4)

SSH_OPTS=(
    # Persist until the EXIT trap closes it: the confirm prompt can sit idle
    -o ControlMaster=auto -o "ControlPath=$CONTROL_PATH" -o ControlPersist=yes
    # ssh.nix limits every host to the 1Password agent's keys
    # (PreferredAuthentications publickey, IdentitiesOnly). The old Mac doesn't
    # know those keys, so allow its login password
    -o "PreferredAuthentications=publickey,keyboard-interactive,password"
    -o IdentitiesOnly=no
    "${SSH_BOUNDS[@]}"
)

# Run a command on the old Mac over the shared connection. Each argument is
# quoted, so paths with spaces survive the remote shell
remote() {
    # shellcheck disable=SC2029  # quoted here on purpose, for the remote shell
    ssh "${SSH_OPTS[@]}" "$HOST" "$(printf '%q ' "$@")"
}

close_connection() {
    [[ -n "$HOST" ]] || return 0
    ssh -o "ControlPath=$CONTROL_PATH" -O exit "$HOST" >/dev/null 2>&1 || true
}

ssh_failure_reason() {
    case "$1" in
        *"Could not resolve hostname"*) echo resolve ;;
        *"Connection refused"*) echo refused ;;
        *"timed out"*) echo timeout ;;
        *"Permission denied"*) echo auth ;;
        *) echo other ;;
    esac
}

remote_read_problem() {
    case "$1" in
        *"No such file or directory"*) echo missing ;;
        *"Operation not permitted"*) echo denied ;;
        *) echo other ;;
    esac
}

explain_ssh_failure() {
    local reason="$1" err="$2" macs
    case "$reason" in
        resolve|timeout)
            log_error "Can't reach $HOST."
            log_info "Check the name, and that the old Mac is awake and signed into Tailscale."
            macs="$(tailscale_macs 2>/dev/null || true)"
            if [[ -n "$macs" ]]; then
                log_info "Macs online on your tailnet: $(paste -sd ' ' - <<< "$macs")"
            fi
            ;;
        refused)
            log_error "$HOST isn't accepting SSH connections."
            log_info "On the old Mac, turn on Remote Login in System Settings → General → Sharing."
            ;;
        auth)
            log_error "$HOST rejected the login."
            log_info "Use the old Mac's login password for $(id -un)."
            ;;
        *)
            log_error "Couldn't connect to $HOST: $err"
            ;;
    esac
    return 0
}

# Print "dir" or "file" for a path on the old Mac. Reading (not just stat-ing)
# is what macOS privacy protection blocks, so this reads a byte of files and
# walks two levels into folders: an app container's top level is readable,
# its Data folder isn't without Full Disk Access
remote_kind() {
    # shellcheck disable=SC2016  # expanded by the remote shell
    remote sh -c 'if [ -d "$1" ]; then find "$1" -maxdepth 2 >/dev/null && echo dir;
        elif [ -e "$1" ]; then head -c 1 "$1" >/dev/null && echo file;
        else echo "$1: No such file or directory" >&2; exit 1; fi' _ "$1"
}

TAILSCALE_BIN="${TAILSCALE_BIN:-/Applications/Tailscale.app/Contents/MacOS/Tailscale}"

# Print the SSH-able name (first label of the MagicDNS name) of each online
# macOS peer on the tailnet. HostName is the Mac's display name, with spaces
tailscale_macs() {
    [[ -x "$TAILSCALE_BIN" ]] || return 0
    run_with_timeout 10 "$TAILSCALE_BIN" status --json 2>/dev/null \
        | jq -r '.Peer // {} | .[] | select(.OS == "macOS" and .Online) | .DNSName | split(".")[0]' \
        | sort
}

# Let the user pick the old Mac from the tailnet; prints nothing if none
pick_host() {
    local macs
    macs="$(tailscale_macs)"
    if [[ -z "$macs" ]]; then
        return 1
    fi
    if [[ "$(wc -l <<< "$macs")" -eq 1 ]]; then
        log_info "Using $macs, the only Mac online on your tailnet."
        echo "$macs"
        return 0
    fi
    gum_clean choose --header "Which Mac are you copying from?" <<< "$macs"
}

# ============================================================================
# This Mac
# ============================================================================

nearest_existing_dir() {
    local dir="$1"
    while [[ ! -d "$dir" ]]; do
        dir="$(dirname "$dir")"
    done
    echo "$dir"
}

# Return 0 if the destination (or the nearest folder that exists) can be
# written to; otherwise print why
check_local_writable() {
    local dir probe
    dir="$(nearest_existing_dir "$HOME/$1")"
    if probe="$(mktemp "$dir/.nx-migrate-probe.XXXXXX" 2>&1)"; then
        rm -f "$probe"
        return 0
    fi
    echo "$probe"
    return 1
}

# Print each owning app that is running, and where
running_apps() {
    local entry process seen="|"
    for entry in "${MIGRATE_ENTRIES[@]}"; do
        process="$(entry_field "$entry" process)"
        [[ -n "$process" && "$seen" != *"|$process|"* ]] || continue
        seen+="$process|"
        if pgrep -x "$process" >/dev/null 2>&1; then
            echo "$process (this Mac)"
        fi
        if remote pgrep -x "$process" >/dev/null 2>&1; then
            echo "$process (old Mac)"
        fi
    done
    return 0
}

# ============================================================================
# rsync
# ============================================================================

RSYNC_BASE=()

set_rsync_base() {
    # com.apple.macl is per-device sandbox state that macOS won't let even
    # Full Disk Access read, so it's never copied
    local rsync_path="$REMOTE_RSYNC" xattrs=(-X "--filter=-x com.apple.macl")
    if ! remote test -x "$REMOTE_RSYNC" 2>/dev/null; then
        # The built-in rsync (openrsync) doesn't support extended attributes
        rsync_path=/usr/bin/rsync
        xattrs=()
    fi
    # A container's metadata belongs to the Mac that created the container
    RSYNC_BASE=(-aH "${xattrs[@]}" --partial --mkpath
        --exclude=.com.apple.containermanagerd.metadata.plist
        # With -X, rsync applies a read-only folder's attributes before writing
        # the files inside it, then can't create them; keep folders writable
        --chmod=Du+w
        -e "ssh -o ControlPath=$CONTROL_PATH -o ControlMaster=no ${SSH_BOUNDS[*]}"
        "--rsync-path=$rsync_path")
}

# Print rsync arguments for one entry, one per line: excludes, then source and
# destination. Remote paths go unescaped; rsync 3.2.4+ protects them itself
rsync_paths() {
    local entry="$1" kind="$2" relpath excludes pattern slash=""
    local -a parts=()
    relpath="$(entry_field "$entry" path)"
    excludes="$(entry_field "$entry" excludes)"
    IFS=',' read -r -a parts <<< "$excludes"
    for pattern in "${parts[@]}"; do
        [[ -n "$pattern" ]] && echo "--exclude=/$pattern"
    done
    while IFS= read -r pattern; do
        [[ -n "$pattern" ]] && echo "--exclude=/$pattern"
    done < <(nix_managed_excludes "$relpath")
    [[ "$kind" == dir ]] && slash=/
    echo "$HOST:$relpath$slash"
    echo "$HOME/$relpath$slash"
}

# Files an itemized rsync dry run would copy
itemized_files() {
    awk '/^>f/ { sub(/^[^ ]+ /, ""); print }' | sort
}

# Print destination files that are newer than the old Mac's copy: the ones a
# --update run would skip
newer_on_destination() {
    local entry="$1" kind="$2" args=()
    mapfile -t args < <(rsync_paths "$entry" "$kind")
    comm -23 \
        <(rsync "${RSYNC_BASE[@]}" --dry-run --itemize-changes "${args[@]}" 2>/dev/null | itemized_files) \
        <(rsync "${RSYNC_BASE[@]}" --dry-run --itemize-changes --update "${args[@]}" 2>/dev/null | itemized_files)
}

# Print local SQLite -wal/-shm files that would end up next to a database
# copied from the old Mac without a matching file from there. Databases the
# entry excludes aren't copied, so their side files stay
# Usage: sqlite_orphans <relpath> <comma-separated excludes>
sqlite_orphans() {
    local relpath="$1" excludes="${2:-}" remote_list f db pattern skip
    local -a patterns=()
    IFS=',' read -r -a patterns <<< "$excludes"
    [[ -d "$HOME/$relpath" ]] || return 0
    # shellcheck disable=SC2016  # expanded by the remote shell
    remote_list="$(remote sh -c 'cd "$1" && find . -name "*.db" -o -name "*.db-wal" -o -name "*.db-shm"' _ "$relpath" 2>/dev/null || true)"
    while IFS= read -r -d '' f; do
        f="./${f#"$HOME/$relpath"/}"
        db="${f%-wal}"
        db="${db%-shm}"
        skip=false
        for pattern in "${patterns[@]}"; do
            # shellcheck disable=SC2053  # the pattern is a glob on purpose
            [[ -n "$pattern" && ( "${db#./}" == $pattern || "${db#./}" == $pattern/* ) ]] && skip=true
        done
        [[ "$skip" == true ]] && continue
        if grep -qxF "$db" <<< "$remote_list" && ! grep -qxF "$f" <<< "$remote_list"; then
            echo "$HOME/$relpath/${f#./}"
        fi
    done < <(find "$HOME/$relpath" \( -name '*.db-wal' -o -name '*.db-shm' \) -print0)
}

# Merge a line-based file: this Mac keeps every line it has and gains the old
# Mac's lines it lacks, old Mac's first. Copied as-is if this Mac has none
merge_file() {
    local relpath="$1" dest="$HOME/$1" old
    old="$(mktemp)"
    if ! remote cat "$relpath" > "$old"; then
        rm -f "$old"
        return 1
    fi
    mkdir -p "$(dirname "$dest")"
    if [[ -f "$dest" ]]; then
        awk 'FNR == NR { print; seen[$0] = 1; next } !seen[$0]' "$old" "$dest" > "$old.merged"
        # Write in place so the file keeps its permissions
        cat "$old.merged" > "$dest"
        rm -f "$old.merged"
    else
        (umask 077 && cp "$old" "$dest")
    fi
    rm -f "$old"
}

# ============================================================================
# Main
# ============================================================================

show_help() {
    cat << 'HELP'
nx migrate - copy app data, saves and history from your old Mac

USAGE:
    nx migrate [host] [-n|--dry-run] [-y|--yes]

    host       The old Mac's Tailscale name, <name>.local or IP address.
               Leave it out to pick from the Macs on your tailnet.
    --dry-run  Run the checks and show what would be copied, then stop.
    --yes      Don't ask before copying.

BEFORE RUNNING, ON THE OLD MAC:
    System Settings → General → Sharing → Remote Login: on, with
    "Allow full disk access for remote users" ticked.
HELP
}

on_exit() {
    close_connection
}

on_signal() {
    trap - INT TERM EXIT
    close_connection
    kill -INT $$
}

# Load the old Mac's Syncthing folders, so nothing is copied into them
load_synced_folders() {
    local config
    config="$(mktemp)"
    if remote cat "Library/Application Support/Syncthing/config.xml" > "$config" 2>/dev/null; then
        syncthing_folder_paths "$config"
    fi
    rm -f "$config"
}

main() {
    local dry_run=false assume_yes=false arg
    for arg in "$@"; do
        case "$arg" in
            --dry-run|-n) dry_run=true ;;
            --yes|-y) assume_yes=true ;;
            -h|--help) show_help; return 0 ;;
            -*) log_error "Unknown option: $arg"; show_help; return 1 ;;
            *) HOST="$arg" ;;
        esac
    done
    if [[ -z "$HOST" ]]; then
        HOST="$(pick_host)" || HOST=""
    fi
    if [[ -z "$HOST" ]]; then
        log_error "Which Mac? Run: nx migrate <host>"
        return 1
    fi

    trap on_exit EXIT
    trap on_signal INT TERM
    caffeinate -ims -w $$ &

    # 1. Reachable, with one connection (and one password prompt) for the run
    log_info "Connecting to $HOST..."
    local err
    if ! err="$(remote true 2>&1 >/dev/null)"; then
        explain_ssh_failure "$(ssh_failure_reason "$err")" "$err"
        return 1
    fi

    local -a synced=()
    mapfile -t synced < <(load_synced_folders)

    # 2. Readable on the old Mac
    local entry relpath kind errfile
    local -a ready=() kinds=() denied=()
    errfile="$(mktemp)"
    for entry in "${MIGRATE_ENTRIES[@]}"; do
        relpath="$(entry_field "$entry" path)"
        if (( ${#synced[@]} )) && inside_synced_folder "$relpath" "${synced[@]}"; then
            log_warning "$relpath is inside a Syncthing folder; Syncthing copies it, skipping"
            continue
        fi
        if kind="$(remote_kind "$relpath" 2>"$errfile")"; then
            if [[ "$kind" != dir && "$kind" != file ]]; then
                denied+=("$relpath: unexpected output from the old Mac's shell: ${kind//$'\n'/ }")
                continue
            fi
            ready+=("$entry")
            kinds+=("$kind")
        elif [[ "$(remote_read_problem "$(cat "$errfile")")" == missing ]]; then
            log_info "$relpath is not on the old Mac, skipping"
        else
            denied+=("$relpath: $(cat "$errfile")")
        fi
    done
    rm -f "$errfile"
    if (( ${#denied[@]} )); then
        log_error "Couldn't read these on the old Mac:"
        printf '    %s\n' "${denied[@]}" >&2
        if [[ "${denied[*]}" == *"Operation not permitted"* ]]; then
            log_info "On the old Mac: System Settings → General → Sharing → Remote Login (i) → tick \"Allow full disk access for remote users\", then re-run."
        fi
        if [[ "${denied[*]}" == *"unexpected output"* ]]; then
            log_info "Something in the old Mac's shell startup prints output for non-interactive SSH sessions; make it quiet, then re-run."
        fi
        return 1
    fi

    # 3. Writable here
    local -a blocked=()
    local why
    for entry in "${ready[@]}"; do
        relpath="$(entry_field "$entry" path)"
        why="$(check_local_writable "$relpath")" || blocked+=("$relpath: $why")
    done
    if (( ${#blocked[@]} )); then
        log_error "Can't write to these on this Mac:"
        printf '    %s\n' "${blocked[@]}" >&2
        log_info "Give your terminal Full Disk Access (System Settings → Privacy & Security), or approve the prompt macOS showed, then restart it and re-run."
        return 1
    fi

    # 4. Apps closed on both Macs
    local running
    running="$(running_apps)"
    if [[ -n "$running" ]]; then
        log_error "Quit these first, so their data isn't copied mid-write:"
        printf '    %s\n' "${running//$'\n'/$'\n'    }" >&2
        return 1
    fi

    # 5-6. Preview
    set_rsync_base
    local i f stats files size newer all_newer=""
    local -a args=()
    local code
    log_info "Preview:"
    for i in "${!ready[@]}"; do
        entry="${ready[$i]}"
        relpath="$(entry_field "$entry" path)"
        if [[ "$(entry_field "$entry" mode)" == merge ]]; then
            echo "    $relpath: merge (keeps this Mac's lines, adds the old Mac's)"
            continue
        fi
        mapfile -t args < <(rsync_paths "$entry" "${kinds[$i]}")
        code=0
        stats="$(rsync "${RSYNC_BASE[@]}" --dry-run --itemize-changes --stats -h "${args[@]}")" || code=$?
        case "$code" in
            0|24) ;;
            23) log_warning "Some files or attributes in $relpath couldn't be copied; the rest will copy" ;;
            *)
                log_error "Couldn't preview $relpath (rsync exit $code). Check the connection to $HOST and re-run."
                return 1
                ;;
        esac
        files="$(awk -F': ' '/Number of regular files transferred/ {print $2}' <<< "$stats")"
        size="$(awk -F': ' '/Total transferred file size/ {print $2}' <<< "$stats")"
        echo "    $relpath: ${files:-0} files, ${size:-0 bytes}"
        newer="$(newer_on_destination "$entry" "${kinds[$i]}")"
        if [[ -n "$newer" ]]; then
            while IFS= read -r f; do
                if [[ "${kinds[$i]}" == file ]]; then
                    all_newer+="    $relpath"$'\n'
                else
                    all_newer+="    $relpath/$f"$'\n'
                fi
            done <<< "$newer"
        fi
    done
    if [[ -n "$all_newer" ]]; then
        log_warning "These are newer on this Mac and will be replaced by the old Mac's copy:"
        printf '%s' "$all_newer" >&2
    fi
    if [[ "$dry_run" == true ]]; then
        log_info "Dry run: nothing copied."
        return 0
    fi
    if [[ "$assume_yes" != true ]] && ! confirm "Copy from $HOST?"; then
        log_info "Nothing copied."
        return 0
    fi

    # 7. Copy, dropping SQLite side files that won't match the copied database
    local orphan prefs=false
    for i in "${!ready[@]}"; do
        entry="${ready[$i]}"
        relpath="$(entry_field "$entry" path)"
        if [[ "$(entry_field "$entry" mode)" == merge ]]; then
            log_info "Merging $relpath..."
            if ! merge_file "$relpath"; then
                log_error "Couldn't merge $relpath. Re-run nx migrate to try again."
                return 1
            fi
            continue
        fi
        log_info "Copying $relpath..."
        mapfile -t args < <(rsync_paths "$entry" "${kinds[$i]}")
        if [[ "${kinds[$i]}" == dir ]]; then
            while IFS= read -r orphan; do
                rm -f "$orphan"
            done < <(sqlite_orphans "$relpath" "$(entry_field "$entry" excludes)")
        fi
        code=0
        rsync "${RSYNC_BASE[@]}" --info=progress2 "${args[@]}" || code=$?
        case "$code" in
            0) ;;
            23) log_warning "Some files or attributes in $relpath couldn't be copied; the rest copied" ;;
            24) log_warning "Some files in $relpath changed while copying (an app on the old Mac may be writing); the rest copied" ;;
            *)
                log_error "Copying $relpath failed (rsync exit $code). Re-run nx migrate to pick up where it stopped."
                return 1
                ;;
        esac
        [[ "$relpath" == Library/Preferences* ]] && prefs=true
    done

    # 8. macOS caches preferences in memory and would write its copy back
    if [[ "$prefs" == true ]]; then
        killall cfprefsd 2>/dev/null || true
    fi

    log_success "Copied from $HOST."
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
