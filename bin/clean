#!/usr/bin/env bash

# System Cleanup Script
# Runs various cleanup tasks and reports space freed

set -euo pipefail

# Get script directory and source shared utilities
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
# shellcheck source=./shared
source "$SCRIPT_DIR/shared"

# Icon-style logging, matching dv/netfix/ren. Set explicitly rather than relying
# on inheriting the export from a sourced bin/dv, which only happens in zsh.
# shellcheck disable=SC2034  # consumed by bin/shared logging functions
USE_ICON_STYLE=true

# Configuration
readonly DOCKER_TIMEOUT=90        # seconds to wait for Docker to become usable
readonly DOCKER_PROBE_TIMEOUT=5   # hard cap on a single `docker info` probe
readonly DOCKER_STOP_PROBE_TIMEOUT=3
readonly DOCKER_BUNDLE_ID="com.docker.docker"
readonly CONFIRM_TIMEOUT=60
readonly OUTPUT_TAIL_LINES=5
readonly SYSTEM_LOG_MAX_AGE_DAYS=7

# Errors that just mean "something else is using this file" - expected, not failures
readonly IN_USE_PATTERN='Permission denied|Operation not permitted|Device busy'
readonly FIND_ERROR_PATTERN='Permission denied|Operation not permitted|No such file'

# Ordered task registry: name|function|needs_sudo|description
readonly TASKS=(
    "nix|cleanup_nix|true|Nix garbage collection and store optimization"
    "brew|cleanup_homebrew|false|Homebrew cleanup"
    "docker|cleanup_docker|false|Docker prune (starts Docker if not running; removes unused images AND named volumes)"
    "pkg|cleanup_packages|false|Package manager cache cleanup (npm, pnpm, yarn)"
    "ruby|cleanup_ruby|false|Ruby gem cleanup"
    "go|cleanup_go|false|Go module cache cleanup"
    "macos|cleanup_macos|true|macOS user caches/logs and old system logs, skipping anything in use"
    "xcode|cleanup_xcode|false|Xcode derived data and archives cleanup"
)

QUIET=false
# shellcheck disable=SC2034  # consumed by log_verbose in bin/shared
VERBOSE=false
FORCE=false
DRY_RUN=false
NO_DOCKER=false
ONLY_TASKS=()
SKIP_TASKS=()

DOCKER_STARTED_BY_US=false
CLEANUP_STARTED=false
CLEANUP_DONE=false
INTERRUPTED=false
CURRENT_CHILD_PID=""
CURRENT_TEMP_FILE=""

# Keep a handle on the real stderr. A signal can land while a redirected
# command is in flight (docker_ready runs `docker info &>/dev/null`), and a trap
# handler inherits whatever redirection is active - which would silently send
# every teardown message to /dev/null.
exec {REAL_STDERR}>&2

# ============================================================================
# Signal handling
# ============================================================================

# Idempotent teardown - must never run an unbounded command, since this also
# runs from a signal handler while another command is already hung
do_cleanup() {
    [[ "$CLEANUP_DONE" == true ]] && return 0
    CLEANUP_DONE=true

    # Undo any redirection inherited from the command the signal interrupted
    exec 2>&"$REAL_STDERR"

    if [[ -n "$CURRENT_CHILD_PID" ]]; then
        kill "$CURRENT_CHILD_PID" 2>/dev/null || true
    fi
    if [[ -n "$CURRENT_TEMP_FILE" ]]; then
        rm -f "$CURRENT_TEMP_FILE"
    fi

    stop_sudo_keepalive

    if [[ "$DOCKER_STARTED_BY_US" == true ]]; then
        echo "" >&2
        stop_docker
    fi

    if [[ "$INTERRUPTED" == true && "$CLEANUP_STARTED" == true ]]; then
        echo "" >&2
        log_warning "Cleanup interrupted"
    fi
}

# A trap handler that merely returns lets bash resume the interrupted command,
# which is why the old version could not be killed with Ctrl-C. Disarm, tear
# down, then re-raise so the shell dies with the correct 128+signal status.
on_signal() {
    local sig="$1"
    INTERRUPTED=true
    trap - INT TERM EXIT
    do_cleanup
    kill "-${sig}" "$$"
}

trap 'on_signal INT' INT
trap 'on_signal TERM' TERM
trap do_cleanup EXIT

# ============================================================================
# Help
# ============================================================================

show_help() {
    cat << EOF
${BOLD}clean${NC} - System cleanup

Runs various cleanup tasks and reports total space freed.

${BOLD}USAGE:${NC}
    clean [options]

${BOLD}OPTIONS:${NC}
    -f, --force        Skip confirmation prompt
    -n, --dry-run      Show what would run without changing anything
    -nd, --no-docker   Skip Docker entirely (never launches Docker.app)
        --only <t>     Run only these tasks (comma separated, repeatable)
        --skip <t>     Skip these tasks (comma separated, repeatable)
    -q, --quiet        Suppress informational output
    -v, --verbose      Show extra detail
    -h, --help         Show this help message

${BOLD}TASKS:${NC}
    nix       Nix garbage collection and store optimization (sudo)
    brew      Homebrew cleanup
    docker    Docker system prune (starts Docker if needed)
    pkg       npm/pnpm/yarn cache cleanup
    ruby      Ruby gem cleanup
    go        Go module cache cleanup
    macos     macOS cache and log cleanup (sudo)
    xcode     Xcode derived data and archives

${BOLD}EXAMPLES:${NC}
    ${GREEN}clean${NC}                     # Run with confirmation prompt
    ${GREEN}clean --force${NC}             # Run without confirmation
    ${GREEN}clean -nd${NC}                 # Run everything except Docker
    ${GREEN}clean --only nix,brew${NC}     # Run just those two tasks
    ${GREEN}clean --skip docker,xcode${NC} # Run everything else
    ${GREEN}clean --dry-run${NC}           # Preview without touching anything

EOF
}

# ============================================================================
# Helpers
# ============================================================================

# Count lines matching a pattern
# `grep -c` prints "0" AND exits 1 when nothing matches, so the obvious
# `$(grep -c ... || echo 0)` yields the string "0\n0" and breaks later arithmetic
count_matching() {
    local pattern="$1" text="$2" n
    [[ -n "$text" ]] || { printf '0'; return 0; }
    n=$(grep -Ec -- "$pattern" <<< "$text") || n=0
    printf '%s' "${n:-0}"
}

count_not_matching() {
    local pattern="$1" text="$2" n
    [[ -n "$text" ]] || { printf '0'; return 0; }
    n=$(grep -Ecv -- "$pattern" <<< "$text") || n=0
    printf '%s' "${n:-0}"
}

# Free space on the volume backing $HOME, in bytes
# Available space on the data volume is the only meaningful measure here: on
# APFS `df /` reports the sealed read-only system snapshot, whose usage never
# moves no matter how much is cleaned out of $HOME, Homebrew or the Nix store
get_free_space() {
    local avail
    if avail=$(df -k "$HOME" 2>/dev/null | tail -1 | awk '{print $4 * 1024}'); then
        if [[ "$avail" =~ ^[0-9]+$ ]]; then
            printf '%s' "$avail"
            return 0
        fi
    fi
    printf '0'
}

bytes_to_human() {
    awk -v b="$1" 'BEGIN {
        if (b >= 1073741824) printf "%.2f GB", b / 1073741824
        else if (b >= 1048576) printf "%.2f MB", b / 1048576
        else if (b >= 1024) printf "%.2f KB", b / 1024
        else printf "%d bytes", b
    }'
}

in_list() {
    local needle="$1"
    shift
    local item
    for item in "$@"; do
        if [[ "$item" == "$needle" ]]; then
            return 0
        fi
    done
    return 1
}

task_names() {
    local entry
    for entry in "${TASKS[@]}"; do
        printf '%s\n' "${entry%%|*}"
    done
}

task_enabled() {
    local name="$1"

    if [[ "$name" == "docker" && "$NO_DOCKER" == true ]]; then
        return 1
    fi

    if (( ${#ONLY_TASKS[@]} > 0 )) && ! in_list "$name" "${ONLY_TASKS[@]}"; then
        return 1
    fi

    if (( ${#SKIP_TASKS[@]} > 0 )) && in_list "$name" "${SKIP_TASKS[@]}"; then
        return 1
    fi

    return 0
}

# Run a command in the background with a live progress indicator, then print a
# trimmed tail of its output
# Usage: run_streamed <label> <output_filter_regex|""> <command> [args...]
# Returns: the command's exit code
run_streamed() {
    local label="$1" filter="$2"
    shift 2

    if [[ "$DRY_RUN" == true ]]; then
        log_info "[dry-run] $label: $*"
        return 0
    fi

    CURRENT_TEMP_FILE=$(mktemp)

    # </dev/null matters: a background child that tries to read the terminal is
    # stopped with SIGTTIN, which would hang the poll loop below forever
    "$@" > "$CURRENT_TEMP_FILE" 2>&1 < /dev/null &
    CURRENT_CHILD_PID=$!

    local show_progress=false
    if [[ -t 2 && "$QUIET" == false ]]; then
        show_progress=true
    fi

    local start=$SECONDS
    while kill -0 "$CURRENT_CHILD_PID" 2>/dev/null; do
        if [[ "$show_progress" == true ]]; then
            printf "\r\033[K%s %s... %ds" "${BLUE}ℹ${NC}" "$label" "$(( SECONDS - start ))" >&2
        fi
        sleep 0.5
    done

    local status=0
    wait "$CURRENT_CHILD_PID" || status=$?
    CURRENT_CHILD_PID=""

    if [[ "$show_progress" == true ]]; then
        printf "\r\033[K" >&2
    fi

    # Trim on the file rather than slurping it - brew cleanup alone can emit
    # thousands of lines
    local output
    if [[ -n "$filter" ]]; then
        output=$(grep -Ev -- "$filter" "$CURRENT_TEMP_FILE" | tail -n "$OUTPUT_TAIL_LINES") || true
    else
        output=$(tail -n "$OUTPUT_TAIL_LINES" "$CURRENT_TEMP_FILE")
    fi
    rm -f "$CURRENT_TEMP_FILE"
    CURRENT_TEMP_FILE=""

    if [[ -n "$output" && "$QUIET" == false ]]; then
        printf '%s\n' "$output"
    fi

    return "$status"
}

# run_streamed plus standard success/warning reporting
# Cleanup steps are best-effort: a failure is reported but never aborts the run
run_step() {
    local label="$1"
    local status=0

    run_streamed "$@" || status=$?

    # In a dry run run_streamed already printed the command; a "complete" line
    # on top of that would imply work was done
    if [[ "$DRY_RUN" == true ]]; then
        return 0
    fi

    if (( status == 0 )); then
        log_success "$label complete"
    else
        log_warning "$label had issues (continuing anyway)"
    fi
    return 0
}

# ============================================================================
# Cleanup tasks
# ============================================================================

cleanup_nix() {
    log_info "Cleaning Nix store..."

    if ! command -v nix-collect-garbage &>/dev/null; then
        log_warning "Nix not installed, skipping"
        return 0
    fi

    # -d also deletes old generations, not just unreachable paths
    run_step "Nix garbage collection" "" sudo -n nix-collect-garbage -d
    run_step "Nix store optimization" "" nix store optimise
}

cleanup_homebrew() {
    log_info "Cleaning Homebrew..."

    if ! command -v brew &>/dev/null; then
        log_warning "Homebrew not installed, skipping"
        return 0
    fi

    # --prune=all removes all cached downloads (the default only prunes >120 days)
    run_step "Homebrew cleanup" "" brew cleanup --prune=all
}

# Bounded readiness probe - the Docker CLI has no client-side timeout of its
# own, and a booting Docker Desktop accepts the socket connection then holds it
# open without replying, so an unwrapped `docker info` can block for minutes
docker_ready() {
    run_with_timeout "${1:-$DOCKER_PROBE_TIMEOUT}" docker info &>/dev/null
}

wait_for_docker() {
    log_info "Waiting for Docker to start (up to ${DOCKER_TIMEOUT}s)..."

    # Deadline against SECONDS, not a sleep counter: time spent inside a slow
    # probe has to count against the budget too
    local deadline=$(( SECONDS + DOCKER_TIMEOUT ))
    local probe
    while (( SECONDS < deadline )); do
        # Clamp the probe to what is left so a hung probe cannot overshoot
        probe=$(( deadline - SECONDS ))
        if (( probe > DOCKER_PROBE_TIMEOUT )); then
            probe=$DOCKER_PROBE_TIMEOUT
        fi

        if docker_ready "$probe"; then
            log_success "Docker is ready"
            return 0
        fi

        if (( SECONDS + 2 < deadline )); then
            sleep 2
        fi
    done

    log_error "Docker failed to become ready within ${DOCKER_TIMEOUT} seconds"
    return 1
}

stop_docker() {
    # Clear first so this is idempotent between the normal path and the traps
    DOCKER_STARTED_BY_US=false

    log_info "Stopping Docker (was not running before cleanup)..."

    # Target the bundle id rather than a display name, which differs between
    # the app bundle (Docker) and the menu bar (Docker Desktop)
    if ! osascript -e "quit app id \"$DOCKER_BUNDLE_ID\"" &>/dev/null; then
        log_warning "Could not stop Docker automatically - you may need to quit it manually"
        return 0
    fi

    # Skip verification when interrupted so Ctrl-C stays snappy
    if [[ "$INTERRUPTED" == true ]]; then
        log_success "Asked Docker to quit"
        return 0
    fi

    # Short probe: this is a liveness check, not another startup wait
    sleep 2
    if docker_ready "$DOCKER_STOP_PROBE_TIMEOUT"; then
        log_warning "Docker may still be running - it will shut down shortly"
    else
        log_success "Docker stopped"
    fi
}

cleanup_docker() {
    log_info "Cleaning Docker..."

    if ! command -v docker &>/dev/null; then
        log_warning "Docker not installed, skipping"
        return 0
    fi

    if [[ "$DRY_RUN" == false ]] && ! docker_ready; then
        log_info "Starting Docker..."
        if ! open -b "$DOCKER_BUNDLE_ID" &>/dev/null; then
            log_warning "Failed to launch Docker application, skipping"
            return 0
        fi

        # Set before waiting: interrupting during startup must still stop the
        # Docker we launched
        DOCKER_STARTED_BY_US=true

        if ! wait_for_docker; then
            log_warning "Docker launched but never became ready, skipping prune"
            return 0
        fi
    fi

    # -a: all unused images, not just dangling. --volumes: unused volumes too
    run_step "Docker prune" "" docker system prune -a --volumes -f
}

cleanup_packages() {
    log_info "Cleaning package manager caches..."

    if command -v npm &>/dev/null; then
        # npm's own deprecation warning about --force is noise; the flag is still required
        run_step "npm cache" 'warn using --force' npm cache clean --force
    fi
    if command -v pnpm &>/dev/null; then
        run_step "pnpm store" "" pnpm store prune
    fi
    if command -v yarn &>/dev/null; then
        run_step "yarn cache" "" yarn cache clean
    fi
    return 0
}

cleanup_ruby() {
    if command -v gem &>/dev/null; then
        run_step "Ruby gem cleanup" "" gem cleanup
    fi
    return 0
}

cleanup_go() {
    if command -v go &>/dev/null; then
        run_step "Go module cache" "" go clean -modcache
    fi
    return 0
}

# Empty a user directory, distinguishing "in use" from genuine failures
clean_user_dir() {
    local dir="$1" label="$2"

    [[ -d "$dir" ]] || return 0

    if [[ "$DRY_RUN" == true ]]; then
        log_info "[dry-run] would empty $dir"
        return 0
    fi

    log_info "Cleaning $label..."

    # -mindepth 1 rather than a `"$dir"/*` glob, which silently skips dotfiles
    local errors status=0
    errors=$(find "${dir:?}" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>&1) || status=$?

    if (( status == 0 )) && [[ -z "$errors" ]]; then
        log_success "$label cleaned"
        return 0
    fi

    local in_use unexpected
    in_use=$(count_matching "$IN_USE_PATTERN" "$errors")
    unexpected=$(count_not_matching "$IN_USE_PATTERN" "$errors")

    if (( in_use > 0 )); then
        log_warning "$label partially cleaned ($in_use items skipped - in use or protected)"
    fi
    if (( unexpected > 0 )); then
        log_warning "$label had $unexpected unexpected errors"
        log_verbose "$errors"
    fi
    return 0
}

# Only touch archived/rotated logs - deleting active logs breaks running loggers
cleanup_system_logs() {
    if [[ "$DRY_RUN" == true ]]; then
        log_info "[dry-run] would remove rotated logs and *.log older than ${SYSTEM_LOG_MAX_AGE_DAYS} days from /var/log"
        return 0
    fi

    if ! sudo -n -v 2>/dev/null; then
        log_warning "Sudo credentials expired - skipping system log cleanup"
        return 0
    fi

    log_info "Cleaning old system logs (best-effort, SIP protects some files)..."

    local deleted=0 output
    # Compressed archives, explicit .old, and numbered rotations
    output=$(sudo -n find /var/log -type f \
        \( -name "*.gz" -o -name "*.bz2" -o -name "*.old" -o -name "*.[0-9]" \) \
        -print -delete 2>&1) || true
    deleted=$(( deleted + $(count_not_matching "$FIND_ERROR_PATTERN" "$output") ))

    output=$(sudo -n find /var/log -type f -name "*.log" \
        -mtime "+${SYSTEM_LOG_MAX_AGE_DAYS}" -print -delete 2>&1) || true
    deleted=$(( deleted + $(count_not_matching "$FIND_ERROR_PATTERN" "$output") ))

    if (( deleted > 0 )); then
        log_success "Removed $deleted old system log files"
    else
        log_info "No old system logs found (or all protected)"
    fi
}

cleanup_macos() {
    log_info "Cleaning macOS caches..."

    clean_user_dir "$HOME/Library/Caches" "user caches"
    clean_user_dir "$HOME/Library/Logs" "user logs"
    cleanup_system_logs
}

# Returns: 0 fully cleaned, 1 partially cleaned, 2 nothing there
clean_xcode_dir() {
    local dir="$1" label="$2"

    [[ -d "$dir" ]] || return 2

    if [[ "$DRY_RUN" == true ]]; then
        log_info "[dry-run] would remove $dir"
        return 0
    fi

    rm -rf "$dir" 2>/dev/null || true
    [[ -d "$dir" ]] || return 0

    local remaining
    remaining=$(find "$dir" -type f 2>/dev/null | wc -l | tr -d ' ')
    if (( remaining > 0 )); then
        log_warning "$label partially cleaned ($remaining files remain - close Xcode to clean fully)"
        return 1
    fi
    return 0
}

cleanup_xcode() {
    log_info "Cleaning Xcode..."

    local cleaned=false partial=false dir_status=0

    local entry dir label
    for entry in "DerivedData" "Archives"; do
        dir="$HOME/Library/Developer/Xcode/$entry"
        label="$entry"
        dir_status=0
        clean_xcode_dir "$dir" "$label" || dir_status=$?
        case $dir_status in
            0) cleaned=true ;;
            1) partial=true ;;
        esac
    done

    if [[ "$cleaned" == true && "$partial" == false ]]; then
        log_success "Xcode cleanup complete"
    elif [[ "$cleaned" == true || "$partial" == true ]]; then
        log_success "Xcode cleanup complete (some items skipped)"
    else
        log_info "No Xcode data to clean"
    fi
}

# ============================================================================
# Orchestration
# ============================================================================

needs_sudo() {
    local entry name sudo_flag
    for entry in "${TASKS[@]}"; do
        IFS='|' read -r name _ sudo_flag _ <<< "$entry"
        if [[ "$sudo_flag" == true ]] && task_enabled "$name"; then
            return 0
        fi
    done
    return 1
}

acquire_sudo() {
    log_info "Acquiring sudo credentials..."
    if ! sudo -v; then
        log_error "Failed to acquire sudo credentials"
        exit 1
    fi
    start_sudo_keepalive
}

show_task_banner() {
    log_warning "This will run system cleanup tasks including:"

    local entry name sudo_flag description
    for entry in "${TASKS[@]}"; do
        IFS='|' read -r name _ sudo_flag description <<< "$entry"
        if ! task_enabled "$name"; then
            continue
        fi
        if [[ "$sudo_flag" == true ]]; then
            echo "  - $description (sudo required)"
        else
            echo "  - $description"
        fi
    done
    echo ""
}

run_cleanup() {
    CLEANUP_STARTED=true

    echo ""
    if [[ "$DRY_RUN" == true ]]; then
        log_info "Dry run - nothing will be changed"
    elif needs_sudo; then
        acquire_sudo
        echo ""
    fi

    log_info "Starting system cleanup..."
    echo ""

    local start_free end_free
    start_free=$(get_free_space)

    local entry name func
    for entry in "${TASKS[@]}"; do
        IFS='|' read -r name func _ _ <<< "$entry"
        if ! task_enabled "$name"; then
            continue
        fi
        "$func"
        echo ""
    done

    # Stop Docker before the summary so the output stays clean
    if [[ "$DOCKER_STARTED_BY_US" == true ]]; then
        stop_docker
        echo ""
    fi

    end_free=$(get_free_space)

    echo "========================================="
    if [[ "$DRY_RUN" == true ]]; then
        log_success "Dry run complete - nothing was changed"
    elif (( start_free == 0 || end_free == 0 )); then
        log_success "Cleanup complete! (could not measure disk usage)"
    elif (( end_free > start_free )); then
        log_success "Cleanup complete! Freed $(bytes_to_human $(( end_free - start_free )))"
    elif (( end_free < start_free )); then
        log_success "Cleanup complete! (free space dropped by $(bytes_to_human $(( start_free - end_free ))) due to concurrent activity)"
    else
        log_success "Cleanup complete! (free space unchanged)"
    fi
    echo "========================================="
}

# ============================================================================
# Argument parsing
# ============================================================================

# Split a comma separated task list into the named array, validating each entry
# shellcheck disable=SC2034  # nameref writes are invisible to shellcheck
add_tasks() {
    local -n target_ref=$1
    local raw="$2"
    local valid
    valid=$(task_names)

    local IFS=','
    local -a parts
    read -r -a parts <<< "$raw"

    local task
    for task in "${parts[@]}"; do
        [[ -n "$task" ]] || continue
        if ! grep -qx -- "$task" <<< "$valid"; then
            log_error "Unknown task: $task"
            log_error "Valid tasks: $(task_names | tr '\n' ' ')"
            exit 2
        fi
        target_ref+=("$task")
    done
}

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -f|--force)
                FORCE=true
                shift
                ;;
            -n|--dry-run)
                DRY_RUN=true
                shift
                ;;
            -nd|--no-docker)
                NO_DOCKER=true
                shift
                ;;
            --only)
                require_argument "$1" "${2:-}" || exit 2
                add_tasks ONLY_TASKS "$2"
                shift 2
                ;;
            --skip)
                require_argument "$1" "${2:-}" || exit 2
                add_tasks SKIP_TASKS "$2"
                shift 2
                ;;
            -q|--quiet)
                QUIET=true
                shift
                ;;
            -v|--verbose)
                # shellcheck disable=SC2034  # consumed by log_verbose in bin/shared
                VERBOSE=true
                shift
                ;;
            -h|--help)
                show_help
                exit 0
                ;;
            *)
                log_error "Unknown option: $1"
                echo ""
                show_help
                exit 2
                ;;
        esac
    done
}

main() {
    parse_args "$@"

    if [[ "$(uname -s)" != "Darwin" ]]; then
        log_error "clean targets macOS only"
        exit 1
    fi

    local enabled=false entry name
    for entry in "${TASKS[@]}"; do
        name="${entry%%|*}"
        if task_enabled "$name"; then
            enabled=true
            break
        fi
    done
    if [[ "$enabled" == false ]]; then
        log_error "No tasks selected"
        exit 2
    fi

    if [[ "$FORCE" == true || "$DRY_RUN" == true ]]; then
        run_cleanup
        return
    fi

    echo ""
    show_task_banner
    if confirm "Continue?" "$CONFIRM_TIMEOUT"; then
        run_cleanup
    else
        log_info "Cleanup cancelled"
    fi
}

main "$@"
