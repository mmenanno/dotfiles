#compdef nx

# Zsh completion for nx (nix dotfiles management script)

_nx() {
    local -a commands
    commands=(
        'up:Apply configuration (darwin-rebuild switch)'
        'apply:Apply configuration (alias)'
        'a:Apply configuration (alias)'
        'check:Check flake for errors'
        'c:Check flake (alias)'
        'lint:Run code quality checks (statix, deadnix)'
        'l:Lint (alias)'
        'update:Update flake dependencies'
        'u:Update (alias)'
        'pull:Pull latest dotfiles from remote'
        'p:Pull (alias)'
        'edit:Open dotfiles in VS Code'
        'e:Edit (alias)'
        'status:Show git status of dotfiles'
        's:Status (alias)'
        'build:Build configuration without applying'
        'b:Build (alias)'
        'diff:Show what would be built (dry-run)'
        'd:Diff (alias)'
        'clean:Clean old generations and optimise the store'
        'cl:Clean (alias)'
        'managed:Manage mutable config files'
        'm:Managed (alias)'
        'pr:Create PR from current changes'
        'help:Show help message'
        'h:Help (alias)'
    )

    local -a managed_subcommands
    managed_subcommands=(
        'diff:Show diff of changed files in VS Code'
        'd:Diff (alias)'
        'revert:Revert to Nix version, discarding app changes'
        'r:Revert (alias)'
        'apply:Apply app changes back into Nix module via Claude'
        'a:Apply (alias)'
    )

    local -a managed_names
    managed_names=(
        'claude:.claude/settings.json'
        'op:.config/op/plugins.sh'
        'vscode:Library/Application Support/Code/User/settings.json'
        'vsmcp:Library/Application Support/Code/User/mcp.json'
        'all:All managed files'
    )
    # npmrc is work-machine-only; suggest it only if a baseline exists
    [[ -f "$HOME/.local/share/nix-managed-baselines/.npmrc" ]] && \
        managed_names+=('npmrc:.npmrc')

    if (( CURRENT == 2 )); then
        _describe 'command' commands
        return
    fi

    # Drop "nx" so _arguments sees the subcommand as the command word
    local cmd=$words[2]
    shift words
    (( CURRENT-- ))

    case "$cmd" in
        managed|m)
            if (( CURRENT == 2 )); then
                _describe 'subcommand' managed_subcommands
            elif (( CURRENT == 3 )); then
                case "$words[2]" in
                    diff|d|revert|r|apply|a)
                        _describe 'file' managed_names
                        ;;
                esac
            fi
            ;;
        up|apply|a)
            _arguments -S \
                '(-hm --home-manager)'{-hm,--home-manager}'[Rebuild only Home Manager (faster)]' \
                '(-fm --force-managed)'{-fm,--force-managed}'[Revert managed files before applying]' \
                '--show-trace[Show full evaluation traces]'
            ;;
        build|b|diff|d)
            _arguments -S \
                '(-hm --home-manager)'{-hm,--home-manager}'[Home Manager only]' \
                '--show-trace[Show full evaluation traces]'
            ;;
        clean|cl)
            _arguments -S \
                '(-f --force)'{-f,--force}'[Skip confirmation prompt]' \
                '(-n --dry-run)'{-n,--dry-run}'[Show what would run without changing anything]' \
                '(-q --quiet -v --verbose)'{-q,--quiet}'[Suppress informational output]' \
                '(-q --quiet -v --verbose)'{-v,--verbose}'[Show extra detail]'
            ;;
        pr)
            _arguments -S \
                '--merge[Enable auto-merge]' \
                '--title[PR title]:title:' \
                '--body[PR body]:body:'
            ;;
    esac
}

_nx "$@"
compdef _nx nx
