#compdef dv

# Zsh completion for dv (superpowered development script)

_dv() {
    local -a commands
    commands=(
        'cd:Navigate to a project or special directory'
        'up:Install/update dependencies, prepare database, build assets'
        'list:List all available projects'
        'ls:List all available projects (alias)'
        'logs:View or clean logs from dv up runs'
        'help:Show help message'
        'h:Show help message (alias)'
    )

    local -a special_dirs
    special_dirs=(
        'dotfiles'
        'dev'
        'writing'
        'tasks'
    )

    # Function to get all project names
    _dv_projects() {
        setopt localoptions null_glob
        local -a projects
        local search_paths=(
            "$HOME/dev"
            "$HOME/dev/git"
            "$HOME/writing"
            "$HOME/tasks"
        )

        # Add special directories
        projects+=("${special_dirs[@]}")

        # Index all projects from search paths
        for search_path in $search_paths; do
            if [[ -d "$search_path" ]]; then
                # Get basename of each directory
                for dir in ${search_path}/*(/N); do
                    projects+=("${dir:t}")
                done
            fi
        done

        # Remove duplicates and sort
        projects=(${(u)${(o)projects}})
        compadd -a projects
    }

    # Main completion logic
    if (( CURRENT == 2 )); then
        _describe 'command' commands
        return
    fi

    # Drop "dv" so _arguments sees the subcommand as the command word
    local cmd=$words[2]
    shift words
    (( CURRENT-- ))

    case "$cmd" in
        cd)
            (( CURRENT == 2 )) && _dv_projects
            ;;
        up)
            _arguments -S \
                '(-f --force)'{-f,--force}'[Reinstall dependencies from scratch]' \
                '(-v --verbose)'{-v,--verbose}'[Show all output instead of the progress UI]'
            ;;
        ls|list)
            _arguments -S \
                '(-d --dev -w --writing)'{-d,--dev}'[Show only projects within ~/dev]' \
                '(-d --dev -w --writing)'{-w,--writing}'[Show only projects within ~/writing]'
            ;;
        logs)
            if (( CURRENT == 2 )); then
                local -a log_subcommands=(
                    'view:View the latest log (default)'
                    'clean:Delete old logs'
                )
                _describe 'subcommand' log_subcommands
            elif [[ "$words[2]" == clean ]]; then
                _arguments -S \
                    '(-a --all -A)'{-a,--all}'[Delete all logs regardless of age]' \
                    '(-ap --all-projects -A)'{-ap,--all-projects}'[Clean logs for every project]' \
                    '(-a --all -ap --all-projects)-A[Delete all logs for every project]'
            fi
            ;;
    esac
}

_dv "$@"
compdef _dv dv
